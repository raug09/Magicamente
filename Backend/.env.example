# Copia este archivo como Backend/.env y rellena los valores.
# Nunca subas el .env real al repositorio (ya está en .gitignore).

# Puerto HTTP del servidor (por defecto 3000)
PORT=3000

# Cadena de conexión a MongoDB (local o Atlas)
MONGO_URI=mongodb://localhost:27017/magicamente

# Secreto para firmar los JWT. OBLIGATORIO en producción:
# si falta, el código usa 'secret' y cualquiera puede falsificar tokens.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# API key de Resend (https://resend.com). Si falta, los correos no se envían: se muestran en consola.
# El dominio remitente (magicamente.online) debe estar verificado en Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Zona horaria con la que se muestran fechas en los correos (las horas se guardan en UTC).
APP_TIMEZONE=UTC

# Remitente de los correos (el dominio debe estar verificado en Resend).
EMAIL_FROM=Soporte <support@magicamente.online>

# URL base del frontend: el correo de recuperación enlaza a <FRONTEND_URL>/reset-password?token=...
FRONTEND_URL=http://localhost:5173

# Orígenes web autorizados por CORS (lista separada por comas, o * para cualquiera).
# Si no se define, solo se permite el origen de FRONTEND_URL.
# CORS_ORIGIN=https://app.magicamente.online

# Número de proxies delante del servidor (p. ej. 1 en Render, Railway, Heroku o Nginx).
# Sin esto, el límite de intentos vería la IP del proxy en lugar de la del cliente.
# TRUST_PROXY=1

# Nivel de los logs: trace | debug | info | warn | error | fatal | silent (por defecto: info)
# LOG_LEVEL=info
