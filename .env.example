# Variables para `docker compose up` (copia este archivo como `.env` junto al docker-compose.yml).
# Para ejecutar el backend sin Docker usa Backend/.env.example.

# OBLIGATORIA. Cadena larga y aleatoria, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto publicado en tu máquina (dentro del contenedor siempre es 3000)
PORT=3000

# Correo (Resend). Sin clave, los correos no se envían.
RESEND_API_KEY=
EMAIL_FROM=

# Dirección del frontend: CORS y enlace del correo de recuperación de contraseña
FRONTEND_URL=http://localhost:5173
# CORS_ORIGIN=https://app.magicamente.online

# Zona horaria por defecto de las cuentas nuevas
APP_TIMEZONE=UTC

# Nº de proxies delante de la API (1 si usas Nginx, Traefik, Render...). Vacío = ninguno.
TRUST_PROXY=

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
